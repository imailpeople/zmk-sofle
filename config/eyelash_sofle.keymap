#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1000  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 100    // 10

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 16 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <500>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <30>;
    };

    Navi_Paste_Copy: Navi_Paste_Copy {
        compatible = "zmk,behavior-tap-dance";
        label = "NAVI_PASTE_COPY";
        #binding-cells = <0>;
        bindings = <&lt 0 C_AC_PASTE>, <&kp C_AC_COPY>;

        tapping-term-ms = <200>;
    };

    Sh_Del_Else_NPC: Sh_Del_Else_NPC {
        compatible = "zmk,behavior-mod-morph";
        label = "SH_DEL_ELSE_NPC";
        bindings = <&Navi_Paste_Copy>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    Sh_ShDel_Else_LAlt: Sh_ShDel_Else_LAlt {
        compatible = "zmk,behavior-mod-morph";
        label = "SH_SHDEL_ELSE_LALT";
        bindings = <&mt LEFT_ALT MINUS>, <&kp LS(DELETE)>;

        #binding-cells = <0>;
        mods = <(MOD_LSFT)>;
    };

    Tab_F1: Tab_F1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TAB_F1";
        #binding-cells = <0>;
        tapping-term-ms = <225>;
        bindings = <&kp TAB>, <&kp F1>;
    };

    mo_Tab_F1: mo_Tab_F1 {
        compatible = "zmk,behavior-hold-tap";
        label = "MO_TAB_F1";
        bindings = <&mo>, <&Grave_F1>;

        #binding-cells = <2>;
        tapping-term-ms = <225>;
        quick-tap-ms = <200>;
        flavor = "hold-preferred";
        hold-while-undecided;
    };

    mo_Grave_F1: mo_Grave_F1 {
        compatible = "zmk,behavior-hold-tap";
        label = "MO_GRAVE_F1";
        #binding-cells = <2>;
        tapping-term-ms = <225>;
        quick-tap-ms = <200>;
        hold-while-undecided;
        bindings = <&mo>, <&Grave_F1>;
    };

    Grave_F1: Grave_F1 {
        compatible = "zmk,behavior-tap-dance";
        label = "GRAVE_F1";
        #binding-cells = <0>;
        tapping-term-ms = <225>;
        bindings = <&kp GRAVE>, <&kp F1>;
    };

    alt_del_else_print: alt_del_else_print {
        compatible = "zmk,behavior-mod-morph";
        label = "ALT_DEL_ELSE_PRINT";
        bindings = <&kp PRINTSCREEN>, <&kp DELETE>;

        #binding-cells = <0>;
        mods = <(MOD_LALT)>;
    };

    alt_menu_else_space: alt_menu_else_space {
        compatible = "zmk,behavior-mod-morph";
        label = "ALT_MENU_ELSE_SPACE";
        bindings = <&kp SPACE>, <&kp K_MENU>;

        #binding-cells = <0>;
        mods = <(MOD_LALT)>;
    };

    ctrl_ralt_else_f5_navi: ctrl_ralt_else_f5_navi {
        compatible = "zmk,behavior-mod-morph";
        label = "CTRL_RALT_ELSE_F5_NAVI";
        bindings = <&lt 5 F5>, <&kp RIGHT_ALT>;

        #binding-cells = <0>;
        mods = <(MOD_LCTL)>;
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&mo_Grave_F1 6 0     &kp N1      &kp N2     &kp N3               &kp N4             &kp N5                &kp UP_ARROW     &kp N6       &kp N7                &kp N8                   &kp N9             &kp N0     &kp BACKSPACE
&kp TAB              &kp Q       &kp W      &kp F                &kp P              &kp G                 &kp DOWN_ARROW   &kp J        &kp L                 &kp U                    &kp Y              &kp SEMI   &kp DELETE
&alt_del_else_print  &kp A       &kp R      &kp S                &kp T              &kp D                 &kp LEFT_ARROW   &kp H        &kp N                 &kp E                    &kp I              &kp O      &kp SQT
&kp LCTRL            &kp Z       &kp X      &kp C                &kp V              &kp B                 &kp RIGHT_ARROW  &kp K        &kp M                 &kp COMMA                &kp DOT            &kp FSLH   &kp BSLH
&kp K_MUTE           &kp ESCAPE  &kp SPACE  &Sh_ShDel_Else_LAlt  &mt LSHIFT ESCAPE  &mt LGUI BACKSLASH    &kp ENTER        &lt 4 ENTER  &alt_menu_else_space  &ctrl_ralt_else_f5_navi  &lt 6 PRINTSCREEN  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Colemak";
        };

        layer_1 {
            display-name = "QWERTY";
            bindings = <
&mo_Grave_F1 6 0     &kp N1      &kp N2     &kp N3               &kp N4             &kp N5                &kp UP_ARROW     &kp N6       &kp N7                &kp N8                   &kp N9             &kp N0     &kp BACKSPACE
&kp TAB              &kp Q       &kp W      &kp E                &kp R              &kp T                 &kp DOWN_ARROW   &kp Y        &kp U                 &kp I                    &kp O              &kp P      &kp DELETE
&alt_del_else_print  &kp A       &kp S      &kp D                &kp F              &kp G                 &kp LEFT         &kp H        &kp J                 &kp K                    &kp L              &kp SEMI   &kp SQT
&kp LCTRL            &kp Z       &kp X      &kp C                &kp V              &kp B                 &kp RIGHT_ARROW  &kp N        &kp M                 &kp COMMA                &kp DOT            &kp FSLH   &kp BSLH
&kp K_MUTE           &kp ESCAPE  &kp SPACE  &Sh_ShDel_Else_LAlt  &mt LSHIFT ESCAPE  &mt LGUI BACKSLASH    &kp ENTER        &lt 4 ENTER  &alt_menu_else_space  &ctrl_ralt_else_f5_navi  &lt 6 PRINTSCREEN  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        layer_2 {
            display-name = "Col-Game";
            bindings = <
&mo_Grave_F1 6 0  &kp N1   &kp N2    &kp N3     &kp N4   &kp N5      &kp UP     &kp N6       &kp N7     &kp N8     &kp N9             &kp N0     &kp BSPC
&kp TAB           &kp Q    &kp W     &kp F      &kp P    &kp G       &kp DOWN   &kp J        &kp L      &kp U      &kp Y              &kp SEMI   &kp DEL
&kp LCTRL         &kp A    &kp R     &kp S      &kp T    &kp D       &kp LEFT   &kp H        &kp N      &kp E      &kp I              &kp O      &kp SQT
&kp LSHFT         &kp Z    &kp X     &kp C      &kp V    &kp B       &kp RIGHT  &kp K        &kp M      &kp COMMA  &kp DOT            &kp FSLH   &kp BSLH
&kp K_MUTE        &kp ESC  &kp LALT  &kp SPACE  &kp RET  &kp LGUI    &kp RET    &lt 4 ENTER  &kp SPACE  &mo 5      &lt 6 PRINTSCREEN  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_3 {
            display-name = "QWE-Game";
            bindings = <
&mo_Grave_F1 6 0  &kp N1   &kp N2    &kp N3     &kp N4   &kp N5      &kp UP     &kp N6       &kp N7     &kp N8     &kp N9             &kp N0     &kp BSPC
&kp TAB           &kp Q    &kp W     &kp E      &kp R    &kp T       &kp DOWN   &kp Y        &kp U      &kp I      &kp O              &kp P      &kp DEL
&kp LCTRL         &kp A    &kp S     &kp D      &kp F    &kp G       &kp LEFT   &kp H        &kp J      &kp K      &kp L              &kp SEMI   &kp SQT
&kp LSHFT         &kp Z    &kp X     &kp C      &kp V    &kp B       &kp RIGHT  &kp N        &kp M      &kp COMMA  &kp DOT            &kp FSLH   &kp BSLH
&kp K_MUTE        &kp ESC  &kp LALT  &kp SPACE  &kp RET  &kp LGUI    &kp RET    &lt 4 ENTER  &kp SPACE  &mo 5      &lt 6 PRINTSCREEN  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_4 {
            display-name = "NumSym";
            bindings = <
&kp GRAVE       &kp NUMBER_1      &kp NUMBER_2   &kp NUMBER_3          &kp NUMBER_4           &kp NUMBER_5               &kp UP_ARROW    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8             &kp NUMBER_9       &kp NUMBER_0  &kp BACKSPACE
&kp TAB         &kp LS(NUMBER_1)  &kp LS(MINUS)  &kp LS(EQUAL)         &kp EQUAL              &mkp MB4                   &kp DOWN_ARROW  &none         &none         &kp LEFT_BRACKET         &kp RIGHT_BRACKET  &none         &kp DELETE
&kp LEFT_SHIFT  &kp NUMBER_1      &kp NUMBER_2   &kp NUMBER_3          &kp NUMBER_4           &kp NUMBER_5               &kp LEFT        &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8             &kp NUMBER_9       &kp NUMBER_0  &kp SQT
&kp LCTRL       &kp GRAVE         &kp LS(GRAVE)  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LS(BACKSPACE)          &kp RIGHT       &kp DELETE    &kp MINUS     &kp COMMA                &kp PERIOD         &kp SLASH     &kp BACKSLASH
&kp K_MUTE      &kp ESCAPE        &kp SPACE      &mt LEFT_ALT MINUS    &mt LEFT_SHIFT ESCAPE  &mt LEFT_META BACKSLASH    &kp ENTER       &kp ENTER     &kp SPACE     &ctrl_ralt_else_f5_navi  &lt 6 PRINTSCREEN  &kp GRAVE
            >;

            sensor-bindings = <&inc_dec_kp LG(C_VOLUME_UP) LG(C_VOLUME_DOWN)>;
        };

        layer_5 {
            display-name = "Navi";
            bindings = <
&none           &none           &none           &none         &none            &none            &kp UP_ARROW  &none        &none           &none           &none         &none            &none
&kp TAB         &kp Q           &kp W           &kp F         &kp P            &to 1            &kp DOWN      &none        &kp LS(COMMA)   &kp PG_DN       &kp PG_UP     &kp LS(PERIOD)   &none
&kp LEFT_SHIFT  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &to 0            &kp LEFT      &kp C_PAUSE  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&kp LCTRL       &kp Z           &kp X           &kp C         &kp V            &none            &kp RIGHT     &none        &kp C_PREVIOUS  &kp END         &kp HOME      &kp C_NEXT       &none
&kp K_MUTE      &none           &none           &mkp LCLK     &mkp RCLK        &kp LEFT_META    &kp ENTER     &kp ENTER    &kp SPACE       &mkp MCLK       &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        layer_6 {
            display-name = "Fn";
            bindings = <
&kp F1      &kp F2          &kp F3           &kp F4          &kp F5             &kp F6              &mmv MOVE_UP     &kp F7        &kp F8           &kp F9    &kp F10    &kp F11  &kp F12
&none       &none           &none            &none           &none              &none               &mmv MOVE_DOWN   &none         &to 2            &to 3     &none      &none    &none
&bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3       &bt BT_SEL 4        &mmv MOVE_LEFT   &out OUT_BLE  &kp PRINTSCREEN  &kp HOME  &kp PG_UP  &to 0    &to 5
&none       &bt BT_CLR_ALL  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &ext_power EP_OFF  &ext_power EP_ON    &mmv MOVE_RIGHT  &out OUT_USB  &rgb_ug RGB_BRD  &kp END   &kp PG_DN  &to 1    &none
&kp K_MUTE  &none           &none            &kp LEFT_ALT    &kp LEFT_SHIFT     &kp LEFT_META       &mkp LCLK        &none         &none            &none     &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };
    };
};
